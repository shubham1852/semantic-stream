# ==============================================================================
# SemanticStream — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=SemanticStream
APP_VERSION=1.0.0
DEBUG=false

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins (no spaces)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ── Database ───────────────────────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./semanticstream.db

# Production (PostgreSQL — uncomment and fill):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/semanticstream

# ── AI Model ───────────────────────────────────────────────────────────────────
# Path to the YOLOv8n ONNX weights file (relative to backend directory)
YOLO_MODEL_PATH=models/weights/yolov8n.onnx

# Detection confidence threshold (0.0–1.0)
CONFIDENCE_THRESHOLD=0.45

# ── Priority Tier Scores ────────────────────────────────────────────────────────
PRIORITY_P1=1.0
PRIORITY_P2=0.8
PRIORITY_P3=0.6
PRIORITY_P4=0.4
PRIORITY_P5=0.1

# ── QP Values ──────────────────────────────────────────────────────────────────
QP_P1=18
QP_P2=22
QP_P3=26
QP_P4=32
QP_P5=40
QP_UNIFORM=28
QP_STATIC_ROI_FACE=20
QP_STATIC_ROI_BG=35

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
